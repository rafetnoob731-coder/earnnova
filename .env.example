# EARNNOVA - Environment Configuration
# Copy this to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# PlatoBoost Configuration
PLATOBOOST_SERVICE_ID=18576
PLATOBOOST_SECRET=2094a802-5198-4581-b757-cf5843633621

# Security
JWT_SECRET=your-jwt-secret-key-change-this
ADMIN_SECRET=your-admin-secret-key
ENCRYPTION_KEY=your-32-char-encryption-key

# Binance Pay
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret

# Site Settings
SITE_URL=https://earnnova.vercel.app
SITE_NAME=EARNNOVA
ADMIN_EMAIL=admin@earnnova.com

# SMTP Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
